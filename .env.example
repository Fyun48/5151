# Cloudflare Tunnel token（不要提交到 git）
# 建議同一條 tunnel 加兩個 Public Hostname，不必新開 GitHub 或第二條 tunnel：
#   https://a5151.reversalplay.me → http://127.0.0.1:5151  （v1）
#   https://b5151.reversalplay.me → http://127.0.0.1:5152  （v2）
TUNNEL_TOKEN=

# 公開站台網址（Discord webhook 點連結記已瀏覽需要）。勿尾斜線
PUBLIC_BASE_URL=https://a5151.reversalplay.me
PUBLIC_BASE_URL_V2=https://b5151.reversalplay.me

# 單人登入（不開放註冊）。也可放在 DATA_DIR/auth.env
AUTH_EMAIL=
AUTH_PASSWORD=
# 選填；沒設會自動寫入 data/session.secret
# SESSION_SECRET=
# 本機 HTTP 不要開；經過 HTTPS 反代才需要
# COOKIE_SECURE=1

# v2 忘記密碼寄信（建議寫在 v2 的 DATA_DIR/auth.env，不要提交到 git）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=591 物件追蹤
# 埠 465 會自動用 TLS；其他埠若要強制 TLS 再設 SMTP_SECURE=1
# SMTP_SECURE=

# v2 通勤路線預設走免費 OSRM。後台「使用 Google Directions」打開才會打計費 API。
# GOOGLE_MAPS_API_KEY=
# v1 若仍有金鑰，需另外設 GOOGLE_DIRECTIONS_ENABLED=1 才會打 Google（預設不打）。
# GOOGLE_DIRECTIONS_ENABLED=
