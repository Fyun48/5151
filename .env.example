# Cloudflare Tunnel token（不要提交到 git）
# 建議同一條 tunnel 加 Public Hostname，不必新開 GitHub 或第二條 tunnel：
#   https://jibbyrenth.reversalplay.me → http://127.0.0.1:5153 與 5155（同一台 v3）
#   https://jibbyrentops.reversalplay.me → http://127.0.0.1:5154  （OPS）
#   a5151 / b5151 / c5151 不再使用
TUNNEL_TOKEN=

# 公開站台網址（Discord webhook 點連結記已瀏覽需要）。勿尾斜線
PUBLIC_BASE_URL=https://jibbyrenth.reversalplay.me
PUBLIC_BASE_URL_V3=https://jibbyrenth.reversalplay.me

# 單人登入（不開放註冊）。也可放在 DATA_DIR/auth.env
AUTH_EMAIL=
AUTH_PASSWORD=
# 選填；沒設會自動寫入 data/session.secret
# SESSION_SECRET=
# 本機 HTTP 不要開；經過 HTTPS 反代才需要
# COOKIE_SECURE=1

# v2 忘記密碼寄信（建議寫在 v2 的 DATA_DIR/auth.env，不要提交到 git）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=591 物件追蹤
# 埠 465 會自動用 TLS；其他埠若要強制 TLS 再設 SMTP_SECURE=1
# SMTP_SECURE=

# v3 Web Push（可寫在 /DATA/AppData/591-tracker-v3/auth.env）。沒填時程式會在資料目錄自動產生 vapid.json
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# v3 live data（v3.db、會員媒體、auth.env）預設放在 Storage1，不再佔用 /DATA 系統卷。
# 搬遷由 .github/workflows/migrate-v3-data-volume.yml 執行（plan / apply）。
# 未設定時 compose 使用預設值；要改位置再開這行。
# V3_DATA_ROOT=/mnt/Storage1/docker_data/591-tracker-v3

# PostgreSQL driver（選填；未設時 DB_DRIVER=sqlite，正式站行為不變）
# 設計與驗證方式見 docs/architecture/postgres-listings-hotpath.md
# DB_DRIVER=sqlite
# PG_URL=postgres://user:password@192.168.0.220:15432/5151_shadow
# 未設 PG_URL 時，pg 會讀標準的 PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE
#
# 會員列表「唯讀快照」的待機（standby）連線（選填；**未設＝行為與以前逐字相同**）：
# 設了就讓 /api/listings 的唯讀快照走 HAProxy 的 pg_ro（25434），其餘（含所有寫入）仍走 PG_URL。
#   範例（web-A）：PG_RO_URL=postgres://user:password@192.168.0.140:25434/5151_shadow
#   範例（web-B）：PG_RO_URL=postgres://user:password@192.168.0.220:25434/5151_shadow
# 連不上待機時整趟退回 PG_URL（不會混用兩個快照）；關閘就是刪掉這一個鍵。
# 開閘步驟／要看哪些指標／最壞後果：docs/runbooks/member-read-replica-routing.md
# 可選微調（都有安全預設，不設就好）：PG_RO_RETRY_COOLDOWN_MS=3000（待機失敗後的冷卻）、
#   PG_RO_CONNECT_TIMEOUT_MS=2000、PG_RO_POOL_MAX=<同 PG_POOL_MAX>、
#   MEMBER_READ_FRESHNESS_MS=5000（會員剛寫過的 uid 多久內走 primary）
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=15000
# PG_CONNECT_TIMEOUT_MS=5000
# PG_POOL_IDLE_MS=10000
# PG_APPLICATION_NAME=5151-v3
# 僅供遷移驗證：允許 /api/listings 回傳尚未裝飾的 PostgreSQL 資料列（預設不開）
# PG_LISTINGS_UNDECORATED=0

# 訪客公開列表「SQL-first 折疊路徑」閘（選填；**預設關**：未設或非 1＝行為與以前逐字相同）。
# 設 1 ⇒ /api/listings 走 SQL-first 折疊（硬依賴 listings.fold_component_root ＋ 零差戳記；
#   欄位不存在或戳記對不上 ⇒ HTTP 503 ＋ [fold-gate]，不降級）。
# 這一行由 docker-compose.yml 宣告後才進得了容器 env（只寫在這裡、不重建＝沒有作用）。
# 開閘＝把下面改成 1；關閘＝刪掉這一行或改成 0。改完（在 compose 檔同一目錄）重建：
#   docker compose -f docker-compose.yml -f docker-compose.override.yml up -d --no-build --no-deps --force-recreate 591-tracker-v3
# 開閘前置檢查與順序：docs/runbooks/5151_same_house_fold_deploy.md §1 第 5 步／§5.1（**只有 Owner 開閘**）
PUBLIC_LISTINGS_SQL_FIRST=0

# PG 模式下 PostgreSQL 失敗時要不要落回本機 SQLite（預設 closed）：
#   讀取一律 fail-open（寧可回舊資料，也不要整個站 500）；
#   寫入預設 fail-closed（往上丟，避免寫進沒有人讀的 SQLite 造成無聲的資料分歧）。
#   真實故障需要「先讓站活著」時可設 open，此時寫入也回退成舊行為（用完記得關掉）。
# PG_SQLITE_FALLBACK=closed

# 測試用（不進正式站；未設時 live PostgreSQL 測試自動 skip）
# PG_TEST_URL=postgres://postgres:password@192.168.0.220:15432/5151_shadow
# PG_TEST_STANDBY_URL=postgres://postgres:password@192.168.0.140:15432/5151_shadow

# 591 座標／社區補齊掃描（輪轉；一次 queueGeoBackfill 最多 80 輪 × 這個筆數）。
# 未設時沿用呼叫端給的 LIST_PAGE_SIZE（= 30）。
# GEO591_BATCH_SIZE=30

# 同一條掃描的**輪轉起點**：預設每個進程啟動時隨機抽（正式站 3 個進程才不會一起從最小的
# post_id 低頭、對同一批欠補物件重複發外部 591 抓取）。設了就用該值當起點（量測／重現用），
# 必須是 0..2^53-1 的整數字串；不合法會退回隨機並在日誌印一行警告。
# GEO591_CURSOR_SEED=0

