# OPS Owner（可沿用 v3 AUTH_*）
# AUTH_EMAIL=demo@example.com
# AUTH_PASSWORD=demopass123
OPS_PORT=5154
OPS_HOST=127.0.0.1
OPS_DATA_DIR=data-ops

# v3 → OPS 遞送（兩邊密鑰必須相同）
OPS_INGEST_SECRET=

# Webhook：Discord / Slack incoming / 自訂 https JSON
OPS_NOTIFY_WEBHOOK_URL=
OPS_NOTIFY_ON_INGEST=0
OPS_NOTIFY_TIMEOUT_MS=8000

